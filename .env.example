# ============================================================
# Commerce GPT - Environment Variables
# ============================================================
# Copy this file to .env.local and fill in your values.
# Never commit .env.local or any file containing secrets.
# ============================================================

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/commerce_gpt?schema=public"

# Auth (NextAuth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-random-secret-here"

# Pinecone Vector Database (https://app.pinecone.io)
PINECONE_API_KEY="pcsk_..."
PINECONE_INDEX="commerce-gpt"

# AI Providers - At least one is required for the chatbot to work
# Deepseek API (https://platform.deepseek.com)
DEEPSEEK_API_KEY="sk-..."

# Groq API (https://console.groq.com)
GROQ_API_KEY="gsk_..."

# Gemini API (https://aistudio.google.com)
GEMINI_API_KEY="AIza..."

# VoyageAI Embeddings (https://voyageai.com)
VOYAGEAI_API_KEY="pa-..."

# Optional: Cartesia (https://cartesia.ai) - not currently used
# CARTESIA_API_KEY="sk_car_..."

# Optional: Unstructured (https://unstructured.io) - not currently used
# UNSTRUCTURED_API_KEY="..."

# Optional: Upstash Redis for rate limiting (https://upstash.com)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Optional: Vercel KV for production
KV_URL=""
KV_REST_API_URL=""
KV_REST_API_TOKEN=""

# Optional: Vercel Blob for file storage
# BLOB_READ_WRITE_TOKEN=""